# ScholarNest Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Database Connection (Supabase PostgreSQL / Standard PostgreSQL)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Gemini AI API Key (Backend Only)
GEMINI_API_KEY=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
